{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    "tests/**/*.ts"
  ]
}
