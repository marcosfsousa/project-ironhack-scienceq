# Large data directories (not needed at runtime)
data/logs/
data/videos/

# Eval artifacts
eval/

# Secrets — never bake into image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.ruff_cache/

# Git
.git/
.gitignore

# IDE and tooling
.vscode/
.devcontainer/
.claude/

# Docs and planning (not needed at runtime)
docs/
notebooks/

# Dev-only files. Both lines are needed: these patterns are root-anchored, so
# `tests/` does not cover frontend/tests, and Dockerfile.web's `COPY frontend/ .`
# would otherwise pull the committed pixel baselines (~1 MB of PNGs) into the
# build context. The final image is unaffected — only dist/ is copied out — but
# the context stays clean.
tests/
frontend/tests

# Frontend build artifacts (not needed in API image)
frontend/node_modules
frontend/.env.local
frontend/dist